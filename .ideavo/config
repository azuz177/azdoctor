{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "bun install"
    }
  ],
  "codeChecks": [
    {
      "name": "Lint Check",
      "command": "bun run lint"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "bun run build"
    }
  ],
  "runStep": [
    {
      "name": "Start Dev Server",
      "command": "bun run dev -- --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [
    {
      "name": "Build for Production",
      "command": "bun run build"
    }
  ],
  "cleanupFiles": [
    "node_modules",
    "dist",
    "dist-ssr",
    ".output",
    ".vinxi",
    ".tanstack",
    ".nitro",
    ".wrangler",
    "*.log"
  ],
  "packageManager": "bun",
  "envPaths": [{"name": "default", "path": ".env"}]
}
